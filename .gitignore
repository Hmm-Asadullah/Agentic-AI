# Ignore common Python and ML artifacts, but keep project files trackable.
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
.python-version

# Packaging / build outputs
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter / notebooks
.ipynb_checkpoints/

# Environment files
.env
.env.*
!.env.example

# Logs and local data
*.log
*.sqlite3
*.db
*.pkl
*.parquet

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# ML / model artifacts
models/
checkpoints/
wandb/
mlruns/
artifacts/
